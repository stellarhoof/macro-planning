{
  "extends": ["../../tsconfig.shared.all.jsonc"],
  "references": [
    { "path": "../lib/tsconfig.json" },
    { "path": "../ui-rats/tsconfig.json" }
  ],
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "paths": {
      "#src/*": ["./src/*"],
      "#dbschema/*": ["./dbschema/*"],
      "#lib/*": ["../lib/src/*"],
      "#ui-rats/*": ["../ui-rats/src/*"]
    },
    "types": ["vite/client"],
    "noEmit": true,

    // :(
    // edgeql-js generates extensionless files
    "module": "esnext",
    "moduleResolution": "bundler"
  }
}
