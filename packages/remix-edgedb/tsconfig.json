{
  "extends": ["../../tsconfig.shared.all.jsonc"],
  "references": [
    { "path": "../lib/tsconfig.json" },
    { "path": "../ui-rats/tsconfig.json" }
  ],
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "paths": {
      "#src/*": ["./src/*"],
      "#lib/*": ["../lib/src/*"],
      "#ui-rats/*": ["../ui-rats/src/*"]
    },
    "types": ["@remix-run/node", "vite/client"],
    "noEmit": true,
    "plugins": [{ "transform": "typia/lib/transform" }]
  }
}
